# ---------------------------------------------------------------------------
# Momentum+ environment variables
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# Every variable the app can use is listed here (see SPEC.md §4 Integrations).
# Phase 1 only requires the Supabase block; later phases add the rest.
# ---------------------------------------------------------------------------

# --- Supabase (Phase 1: auth + database) ------------------------------------
# Project URL and keys from supabase.com → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only (webhooks, imports, admin actions). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the app (used for auth redirects / sign-in links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (billing) --------------------------------------------------------
# Deliberately NOT env vars: the Stripe secret key, prices, and webhook secret
# are configured in-app at Admin -> Billing (stored in app_settings). Nothing
# Stripe-related belongs in this file.

# --- Go High Level (Phase 3: billing source of truth) -----------------------
GHL_API_KEY=
GHL_LOCATION_ID=
# Shared secret for /api/webhooks/ghl. The GHL workflow sends either
# x-ghl-signature (hex HMAC-SHA256 of the body) or x-webhook-secret (verbatim).
GHL_WEBHOOK_SECRET=
# JSON map: GHL product id -> tier. Payments for unmapped products are skipped.
# Example: {"prod_abc":"sub_monthly","prod_def":"sub_3mo","prod_ghi":"sub_6mo","prod_jkl":"sub_annual"}
GHL_PRODUCT_TIER_MAP=
# Public GHL checkout/renewal link shown on the /expired page.
NEXT_PUBLIC_GHL_RENEW_URL=

# --- Google Sheets (Phase 3: TSLS registration import) ----------------------
# Share the registration sheet with this service account (edit access so the
# import can mark rows processed). Private key keeps its \n escapes in .env.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
TSLS_REGISTRATION_SHEET_ID=
# Range read by the import (header row first). Default: Sheet1!A1:Z
TSLS_SHEET_RANGE=
# Let the import stamp "processed <timestamp>" onto each imported row. OFF
# unless set to exactly 1, and off is the right answer for a sheet with
# automations hanging off it: the stamp is only a fast-skip hint, import_log
# is what prevents a second grant, and the target column is INFERRED from the
# header row. With this unset the access token is minted read-only, so the
# credential cannot modify the sheet — share it as Viewer and there is no
# path at all. Costs one database lookup per row per run.
TSLS_SHEET_WRITEBACK=
# Import idempotency year — a FALLBACK now, not the usual source. The import
# asks the TSLS bridge which season it is (TSLS flips that when registration
# opens), so a new year needs no edit here. This is what it uses when the
# bridge is down or not yet deployed. Never inferred from the date: a January
# run guessing the new year would re-import and re-grant everyone from the
# October before. See lib/tsls-event-year.ts.
TSLS_EVENT_YEAR=
# JSON map: registration type (lowercased) -> tier + months. VIP defaults to
# tsls_vip/3 months per spec; every other type MUST be mapped here or its rows
# are skipped and reported. Example:
# {"general admission":{"tier":"tsls_attendee","months":1}}
TSLS_TYPE_MAP=

# --- Zoom (Phase 2) ---------------------------------------------------------
# App (a): Server-to-Server OAuth — meeting creation + attendance reports.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Secret Token from the same Zoom app (Feature -> Event Subscriptions) —
# verifies the recording.completed webhook that auto-imports recordings.
# Preferred: paste it in Admin -> Connections -> Zoom (Part 3) instead; this
# env var is only the fallback.
ZOOM_WEBHOOK_SECRET_TOKEN=
# App (b): Meeting SDK app — powers the in-page embedded live room.
# The signature is minted server-side; the secret must stay server-only.
ZOOM_SDK_CLIENT_ID=
ZOOM_SDK_CLIENT_SECRET=

# --- Stream Chat (Phase 4: community) ---------------------------------------
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# --- Mux (Phase 5: video) ---------------------------------------------------
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# --- Anthropic (Phase 5: AI session summaries) ------------------------------
ANTHROPIC_API_KEY=

# --- YouTube Data API (Branching Out podcast) --------------------------------
# Optional. Exact publish dates + full show notes for the back-catalog import
# (scraping only sees "2 years ago" on old videos). Usually connected in-app
# via Admin -> Connections instead; this env var is the fallback.
YOUTUBE_API_KEY=

# --- Cron protection (Vercel cron routes) -----------------------------------
CRON_SECRET=

# --- Zapier / inbound onboarding webhook -------------------------------------
# Shared secret for POST /api/webhooks/zapier (header: x-api-key). Generate a
# long random string. Zapier action body: {"email","name","plan"} where plan is
# monthly | 3month | 6month | 12month | annual | attendee | vip | speaker |
# sponsor. Add "quiet": true to create the account WITHOUT a Momentum+ email
# (the TSLS Companion bridge does this — it is the sole inviter). Gift plans
# also accept "startAt" (ISO date): a future date creates the account now but
# holds the gift until then (TSLS sends the first of the event month, so the
# free months start with the event — requires migration 0068).
# This same secret also authenticates POST /api/bridge/profile, which TSLS
# calls to mirror a speaker's profile onto their Momentum+ listing (enter
# once, appears in both). No separate key needed.
ZAPIER_WEBHOOK_SECRET=
# Preferred bridge key for the TSLS→Momentum+ routes (/api/bridge/*): set the
# SAME value here and as MOMENTUM_PROVISION_KEY in the TSLS project. Exists
# because Vercel can't reveal a stored secret to copy across projects — mint
# a fresh value (e.g. `openssl rand -hex 32`) and set it in both places.
# ZAPIER_WEBHOOK_SECRET keeps working for existing callers.
#
# ROTATION: both keys are accepted at once, which is what makes rotation
# possible without downtime — set the new value on both projects, confirm
# traffic, then blank the old one. Rotate after the event, after any
# contractor handover, and if a key is ever pasted anywhere it shouldn't be.
MOMENTUM_BRIDGE_KEY=
# The reveal is the one IRREVERSIBLE action on the bridge — it activates
# every parked grant and emails every guest — so it has its own secret and
# MOMENTUM_BRIDGE_KEY deliberately does not open it (TSLS security review,
# 2026-08-19). The provisioning key runs in a sync loop all day; this one is
# used once, ever. Mint separately (`openssl rand -hex 32`) and give TSLS the
# same value as its reveal secret. A dry run accepts either key, so wiring
# can be verified without handing this one around. Unset → the reveal 503s
# with a message saying so, rather than falling back.
MOMENTUM_REVEAL_KEY=

# --- Web Push (PWA notifications) -------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
# The public key is baked into the client bundle; the private key signs sends.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: address), used in the VAPID JWT.
VAPID_SUBJECT=mailto:hello@momentumplus.co

# --- GHL email branding ------------------------------------------------------
# From line for member emails sent through GHL (announcements, reminders,
# notices). Defaults to "Momentum+ Team <grow@sierralearnership.com>" if unset.
GHL_EMAIL_FROM=

# --- Resend webhook (auth email delivery events) -----------------------------
# Signing secret (whsec_...) from Resend -> Webhooks after adding the endpoint
# https://momentumplus.co/api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# --- TSLS Companion bridge: SSO handoff --------------------------------------
# Shared secret for POST /api/sso/handoff (header: x-api-key). Lets the TSLS
# Companion exchange this secret + a member email for a one-time Momentum+
# login URL, so members cross from TSLS into Momentum+ with one click. Use a
# long random string, DIFFERENT from ZAPIER_WEBHOOK_SECRET.
SSO_HANDOFF_SECRET=

# Reverse crossover: a "Summit Event App" sidebar link that one-click signs a
# Momentum+ member INTO the TSLS event app. The link only appears when the URL
# below is set (i.e. during event season). TSLS_SSO_KEY = TSLS's
# TSLS_SSO_SECRET; members without a TSLS account land on the public event app.
NEXT_PUBLIC_TSLS_EVENT_URL=          # e.g. https://thetslsapp.com
TSLS_SSO_KEY=

# TEST HARNESS ONLY — never set this on a real deployment. A deployed build
# with no Supabase credentials is a misconfiguration and fails closed (503
# from the middleware, no admin from getAdminAccess). The Playwright suite
# serves a DELIBERATELY credential-free preview build, and `next start` always
# reports NODE_ENV=production, so it needs an explicit way to say "the missing
# credentials are on purpose". playwright.config.ts and the e2e CI job set it.
ALLOW_UNCONFIGURED_PREVIEW=
